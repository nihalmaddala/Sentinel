# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Tavily ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# ── Neo4j AuraDB ──────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=...

# ── GitHub App ────────────────────────────────────────────────────────────────
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=some-random-secret-string
# Paste the full private key contents, with literal \n for newlines
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

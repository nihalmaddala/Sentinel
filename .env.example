# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Tavily ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# ── Neo4j AuraDB ──────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=...

# ── GitHub App ────────────────────────────────────────────────────────────────
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=some-random-secret-string
# Option A: path to the .pem file (recommended — ask Saketh for the .pem file)
GITHUB_PRIVATE_KEY_PATH=./argus-security-linter.2026-03-06.private-key.pem
# Option B: paste the full private key inline (with literal \n for newlines)
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
WEBHOOK_PATH=/api/webhook
